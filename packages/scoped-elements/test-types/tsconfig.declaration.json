{
  "compilerOptions": {
    "module": "NodeNext",
    "strict": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "../tmp-declaration-output",
    "target": "esnext",
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true
